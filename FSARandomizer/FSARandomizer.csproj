<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>FSA Randomizer</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSALib" Version="1.3.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- FSALib packs its asset JSON (actors, stages, worlds, ...) as contentFiles without
       copyToOutput, so copy them explicitly so Assets.* is populated at runtime.
       tileproperties.json is left out: FSALib 1.3.0 (net8.0) cannot parse its enum strings,
       which makes Assets.Reload() throw, and the randomizer does not use tile properties. -->
  <ItemGroup>
    <Content Include="$(PkgFSALib)\contentFiles\any\any\assets\**"
             Exclude="$(PkgFSALib)\contentFiles\any\any\assets\tileproperties.json"
             CopyToOutputDirectory="PreserveNewest"
             Link="assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
